<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ventanita de Javier sobre lo que esté abierto (JarvisRapido): un
         puente de Capacitor (AppCompat), translúcido y FLOTANTE (mide solo lo que dibuja).
         Lo que se ve lo dibuja la página jarvis-rapido.html; detrás sigue a
         la vista lo que había (inicio, YouTube…), SIN oscurecer: solo la hoja
         completa del widget oscurece, y lo pone JarvisRapido.aplicarModo(). -->
    <style name="JarvisRapido" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <!-- FLOTANTE: sin esto Android estira la ventana a toda la pantalla aunque
             JarvisRapido le pida un tamaño chico, y lo de atrás no se podía tocar
             («sale pero no deja tocar nada de lo que hay de fondo»). -->
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowMinWidthMajor">0%</item>
        <item name="android:windowMinWidthMinor">0%</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
