<?xml version="1.0" encoding="utf-8"?>
<!-- Mini-widget «Jarvis», CHICO. Se usa en el propio recuadro: el micrófono
     pregunta por voz y la respuesta sale aquí (y se lee); «Escribile…» abre
     solo una barrita sobre el teclado. El botón de arriba lo agranda para
     ver la conversación. Colores de la hoja de Jarvis en tema oscuro. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_jarvis_fondo"
    android:orientation="vertical"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/jarvis_cabecera"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="6dp">

        <LinearLayout
            android:id="@+id/jarvis_marca"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Jarvis"
                android:src="@drawable/jarvis_ic_chispa" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Jarvis"
                android:textColor="@color/jv_tinta"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/jarvis_estado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/jv_acento"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/jarvis_tamano"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="Agrandar el widget"
            android:padding="7dp"
            android:src="@drawable/jarvis_ic_expandir" />
    </LinearLayout>

    <TextView
        android:id="@+id/jarvis_ultima"
        android:layout_width="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="4"
        android:paddingTop="2dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp"
        android:text="Hablale o escribile: la respuesta sale aquí."
        android:textColor="@color/jv_tinta"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/jarvis_escribir"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/jarvis_campo"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Escribile a Jarvis…"
            android:textColor="@color/jv_tenue"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/jarvis_hablar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/jarvis_circulo_acento"
            android:contentDescription="Hablarle a Jarvis"
            android:padding="11dp"
            android:src="@drawable/jarvis_ic_mic_oscuro" />
    </LinearLayout>
</LinearLayout>
