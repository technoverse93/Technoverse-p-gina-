<?xml version="1.0" encoding="utf-8"?>
<!-- Una vuelta de la conversación del widget: la pregunta a la derecha y
     la respuesta de Jarvis a la izquierda, como en la app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/jarvis_fila_p"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="40dp"
        android:background="@drawable/jarvis_burbuja_yo"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="12dp"
        android:paddingBottom="7dp"
        android:textColor="#E7EFEC"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/jarvis_fila_r"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/jarvis_burbuja_ia"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:textColor="#D9E4E0"
        android:textSize="13sp" />
</LinearLayout>
