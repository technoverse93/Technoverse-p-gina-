<?xml version="1.0" encoding="utf-8"?>
<!-- Ventanita del mini-widget (JarvisRapido.java). La capa de atrás
     oscurece la pantalla de inicio y, tocándola, se cierra; la tarjeta va
     abajo y su alto lo calcula el código según el teclado y las barras. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rapido_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99020A14"
    android:clickable="true"
    android:focusable="false">

<LinearLayout
    android:id="@+id/rapido_tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/jarvis_rapido_fondo"
    android:clickable="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Technoverse"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Jarvis"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/rapido_voz_alta"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/jarvis_circulo_suave"
            android:contentDescription="Respuestas habladas"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/jarvis_ic_voz_si" />

        <ImageButton
            android:id="@+id/rapido_abrir"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/jarvis_circulo_suave"
            android:contentDescription="Abrir en la app"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/jarvis_ic_abrir" />

        <ImageButton
            android:id="@+id/rapido_cerrar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/jarvis_circulo_suave"
            android:contentDescription="Cerrar"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/jarvis_ic_cerrar" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/rapido_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/rapido_lista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/rapido_estado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#9DB7C9"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/rapido_controles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/rapido_leyendo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Leyendo la respuesta…"
            android:textColor="#D7E4EE"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/rapido_pausa"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/widget_jarvis_boton"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Pausar"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rapido_callar"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_jarvis_boton"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Callar"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/jarvis_campo"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <EditText
            android:id="@+id/rapido_texto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Escribile a Jarvis…"
            android:importantForAutofill="no"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#7F96AC"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/rapido_microfono"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/jarvis_circulo_suave"
            android:contentDescription="Hablarle a Jarvis"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/jarvis_ic_mic" />

        <ImageButton
            android:id="@+id/rapido_enviar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/jarvis_circulo_acento"
            android:contentDescription="Enviar"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/jarvis_ic_enviar" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
