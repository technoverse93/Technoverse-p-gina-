# Cabeceras servidas por Cloudflare para todo el sitio.
# ---------------------------------------------------------------------------
# Los assets de /assets/* llevan hash en el nombre (index-a1b2c3.js), así que
# nunca cambian de contenido bajo el mismo nombre: se pueden cachear para
# siempre. index.html en cambio NO debe cachearse — es el que apunta a los
# hashes nuevos después de cada deploy; si el navegador se queda con uno viejo
# pide archivos que ya no existen (el error "Failed to fetch dynamically
# imported module" que ya se maneja también en src/main.tsx).

/*
  # Impide que el navegador "adivine" el tipo de un archivo e interprete como
  # script algo que se sirvió como imagen o texto.
  X-Content-Type-Options: nosniff
  # No permite que el sitio se incruste en un <iframe> de otro dominio
  # (defensa contra clickjacking sobre el panel de administración).
  X-Frame-Options: DENY
  # Al salir hacia otro sitio solo se envía el dominio, nunca la ruta completa
  # (evita filtrar URLs internas del panel en la cabecera Referer).
  Referrer-Policy: strict-origin-when-cross-origin
  # La app no usa cámara, micrófono ni geolocalización: se apagan de raíz.
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

# HUECO CORREGIDO — la ruta /admin quedaba fuera.
#
# La app no usa una librería de rutas, pero sí cambia la dirección a mano:
#   src/App.tsx →  window.history.pushState(null, "", "/admin")
#
# Como wrangler.jsonc usa not_found_handling: "single-page-application",
# entrar directo a /admin (por marcador o escribiéndolo) devuelve el contenido
# de index.html, pero la URL de esa respuesta es /admin. Las reglas de arriba
# apuntan a "/index.html" y a "/", así que NINGUNA la alcanzaba: la pantalla de
# administración —la más usada a diario— era la única que podía quedar servida
# desde una copia vieja del navegador, con las referencias a archivos que ya no
# existen.
#
# Se cubren las dos formas (con y sin barra final, y cualquier subruta).
/admin
  Cache-Control: no-cache, no-store, must-revalidate

/admin/*
  Cache-Control: no-cache, no-store, must-revalidate
